# AWS SES Configuration for Email Verification
# Must verify the sender email address in AWS SES console

# Local frontend host used for CORS during development
FRONTEND_HOST=http://localhost:5174

# Additional allowed CORS origins, comma-separated
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Sender email address (must be verified in AWS SES)
SENDER_EMAIL=no-reply@your-travel-app.com

# AWS Region where SES is configured
AWS_REGION=ap-south-1

# AWS Credentials (optional - will use default AWS profile/credentials if not set)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

