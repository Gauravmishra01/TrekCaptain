# AWS SES Configuration for Email Verification
# Must verify the sender email address in AWS SES console

# Sender email address (must be verified in AWS SES)
SENDER_EMAIL=no-reply@your-travel-app.com

# AWS Region where SES is configured
AWS_REGION=ap-south-1

# AWS Credentials (optional - will use default AWS profile/credentials if not set)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

